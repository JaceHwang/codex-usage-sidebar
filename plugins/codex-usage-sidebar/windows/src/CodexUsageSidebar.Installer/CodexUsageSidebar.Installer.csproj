<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0;net8.0-windows10.0.19041.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</UseWPF>
    <OutputType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">WinExe</OutputType>
    <StartupObject Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">CodexUsageSidebar.Installer.InstallerApplication</StartupObject>
    <ApplicationManifest Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <AssemblyMetadata Include="DeviceSourceCommit" Value="$(DeviceSourceCommit)" Condition="'$(DeviceSourceCommit)' != ''" />
    <AssemblyMetadata Include="DevicePayloadManifestSha256" Value="$(DevicePayloadManifestSha256)" Condition="'$(DevicePayloadManifestSha256)' != ''" />
    <AssemblyMetadata Include="InstallerPayloadMode" Value="$(InstallerPayloadMode)" Condition="'$(InstallerPayloadMode)' != ''" />
    <AssemblyMetadata Include="EmbeddedPayloadVersion" Value="$(EmbeddedPayloadVersion)" Condition="'$(EmbeddedPayloadVersion)' != ''" />
    <AssemblyMetadata Include="EmbeddedSourceCommit" Value="$(EmbeddedSourceCommit)" Condition="'$(EmbeddedSourceCommit)' != ''" />
    <AssemblyMetadata Include="EmbeddedPayloadManifestSha256" Value="$(EmbeddedPayloadManifestSha256)" Condition="'$(EmbeddedPayloadManifestSha256)' != ''" />
    <AssemblyMetadata Include="EmbeddedCodexRuntimeSource" Value="$(EmbeddedCodexRuntimeSource)" Condition="'$(EmbeddedCodexRuntimeSource)' != ''" />
    <AssemblyMetadata Include="EmbeddedCodexRuntimeSha256" Value="$(EmbeddedCodexRuntimeSha256)" Condition="'$(EmbeddedCodexRuntimeSha256)' != ''" />
    <EmbeddedResource Include="$(EmbeddedPayloadDirectory)\**\*"
                      Condition="'$(InstallerPayloadMode)' == 'embedded-release' and Exists('$(EmbeddedPayloadDirectory)')">
      <LogicalName>CodexUsageSidebar.Payload.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
