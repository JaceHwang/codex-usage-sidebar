<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net8.0;net8.0-windows10.0.19041.0</TargetFrameworks>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</UseWPF>
    <OutputType Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">WinExe</OutputType>
    <StartupObject Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">CodexUsageSidebar.Installer.InstallerApplication</StartupObject>
    <ApplicationManifest Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <AssemblyMetadata Include="DeviceSourceCommit" Value="$(DeviceSourceCommit)" Condition="'$(DeviceSourceCommit)' != ''" />
    <AssemblyMetadata Include="DevicePayloadManifestSha256" Value="$(DevicePayloadManifestSha256)" Condition="'$(DevicePayloadManifestSha256)' != ''" />
    <AssemblyMetadata Include="InstallerPayloadMode" Value="$(InstallerPayloadMode)" Condition="'$(InstallerPayloadMode)' != ''" />
  </ItemGroup>
</Project>
