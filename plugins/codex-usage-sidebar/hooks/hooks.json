{
  "description": "Keeps the single Codex usage header companion installed after Codex or plugin updates.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${PLUGIN_ROOT}/scripts/sidebar-control.sh\" ensure --plugin-root \"${PLUGIN_ROOT}\" --plugin-data \"${PLUGIN_DATA}\" >/dev/null 2>&1 || true",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\scripts\\sidebar-control-windows.ps1\" ensure -PluginRoot \"${PLUGIN_ROOT}\" -PluginData \"${PLUGIN_DATA}\"",
            "async": true
          }
        ]
      }
    ]
  }
}
