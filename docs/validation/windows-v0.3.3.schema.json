{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex Usage Sidebar Windows v0.3.3 real-device validation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "sourceCommit", "architecture", "windowsBuild", "codexFileBuild", "completedAt", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "const": "0.3.3" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "architecture": { "const": "x64" },
    "windowsBuild": { "type": "integer", "minimum": 22000 },
    "codexFileBuild": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){3}$" },
    "completedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "cases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "geometry", "interaction", "lifecycle"],
      "properties": {
        "visual": { "type": "array", "items": { "$ref": "#/$defs/visualCase" } },
        "geometry": { "type": "array", "items": { "$ref": "#/$defs/namedCase" } },
        "interaction": { "type": "array", "items": { "$ref": "#/$defs/namedCase" } },
        "lifecycle": { "type": "array", "items": { "$ref": "#/$defs/namedCase" } }
      }
    }
  },
  "$defs": {
    "visualCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "scale", "theme", "language", "result"],
      "properties": {
        "layout": { "enum": ["wide", "narrow", "right-pane"] },
        "scale": { "enum": [100, 125, 150, 200] },
        "theme": { "enum": ["light", "dark", "system"] },
        "language": { "enum": ["en", "zh-CN"] },
        "result": { "const": "pass" }
      }
    },
    "namedCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "result"],
      "properties": {
        "name": { "type": "string" },
        "result": { "const": "pass" }
      }
    }
  }
}
